# Public origin of the site (canonical URLs, sitemap). On Vercel the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (https://resend.com). Without RESEND_API_KEY the form shows "Something went wrong".
RESEND_API_KEY=
# Optional: where messages are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=
# Optional: verified sender, e.g. "MyLink Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
