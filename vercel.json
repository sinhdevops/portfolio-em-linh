{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "outputs/portfon-clone",
  "functions": {
    "api/serve.js": {
      "includeFiles": "outputs/portfon-clone/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/((?!assets/|api/)[^.]*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/images/:path*",
      "destination": "/api/serve?path=images/:path*"
    },
    {
      "source": "/assets/cms/:path*",
      "destination": "/api/serve?path=:path*"
    },
    {
      "source": "/404",
      "destination": "/api/serve?page=404"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us/index.html"
    },
    {
      "source": "/my-portfolio",
      "destination": "/my-portfolio/index.html"
    },
    {
      "source": "/my-portfolio/:slug",
      "destination": "/my-portfolio/:slug/index.html"
    },
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/blogs",
      "destination": "/blogs/index.html"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/blogs/:slug/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/my-portfolio/lumora-beauty-rebrand",
      "destination": "/my-portfolio/web-design",
      "permanent": true
    },
    {
      "source": "/my-portfolio/aether-mobile-experience",
      "destination": "/my-portfolio/app-design",
      "permanent": true
    },
    {
      "source": "/my-portfolio/virex-marketing-website",
      "destination": "/my-portfolio/design-system",
      "permanent": true
    },
    {
      "source": "/my-portfolio/nova-saas-platform",
      "destination": "/my-portfolio/ai-film-creation-tools",
      "permanent": true
    }
  ]
}
